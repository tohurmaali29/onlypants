# Postgres connection. On Supabase use the *transaction pooler* URL (port 6543).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Gmail SMTP: smtp.gmail.com / 465 / your address / an App Password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OnlyPants <you@gmail.com>"
ADMIN_NOTIFY_EMAIL=
# Random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Signs customer order links. Random string, keep stable once live.
ORDER_LINK_SECRET=
